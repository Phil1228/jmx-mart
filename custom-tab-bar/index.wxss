.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 110rpx;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #eee;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #666;
}
.tab-item .ico { font-size: 40rpx; line-height: 1; }
.tab-item .txt { font-size: 22rpx; margin-top: 6rpx; }
.tab-item.active { color: #c8102e; }
.tab-item.active .txt { font-weight: 700; }
