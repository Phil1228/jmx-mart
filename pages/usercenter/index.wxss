page { background: #f5f6f8; }
.mine { min-height: 100vh; padding-bottom: 40rpx; }
.login-area {
  padding: 64rpx 24rpx 16rpx;
  background: #fff;
}
.login-first { display: flex; flex-direction: column; align-items: center; }
.login-banner {
  height: 72rpx;
  background: var(--red);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
.user-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #d9d9d9;
}
.user-nick {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.user-exit {
  font-size: 24rpx;
  color: #c8102e;
  font-weight: 600;
}

.section { background: #fff; margin-bottom: 1rpx; }
.section-title {
  height: 64rpx;
  background: #fff;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}
.item-ic { font-size: 34rpx; }

.recluit {
  margin: 16rpx 24rpx;
  background: linear-gradient(135deg, #fff5f6, #fff);
  border-radius: 20rpx;
  padding: 24rpx;
}
.rec-head { margin-bottom: 16rpx; }
.rec-kpi {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--red);
}
.rec-sub { display: block; font-size: 24rpx; color: #555; margin-top: 4rpx; }
.rec-tiers {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.tier {
  flex: 1;
  text-align: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx;
  border: 1rpx solid #f0f0f0;
}
.tier-num { display: block; font-size: 30rpx; font-weight: 800; color: var(--red); }
.tier-d { font-size: 20rpx; color: #888; }
.rec-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: var(--red);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 40rpx;
}
