.uc-page { display:flex; flex-direction:column; min-height:100vh; background:#f5f6f8; }
.uc-title { text-align:center; font-size:32rpx; font-weight:700; margin-top:180rpx; color:#1a1a1a; }
.uc-body { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.uc-placeholder { font-size:28rpx; color:#999; margin-bottom:40rpx; }
.uc-back { padding:40rpx; background:#fff; border-radius:40rpx; font-size:28rpx; color:#c8102e; }
