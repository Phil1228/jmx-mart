page { background: #f5f6f8; }
.detail { min-height: 100vh; background: #f5f6f8; padding-bottom: 0; }

/* 1. 返回 */
.back {
  position: fixed; top: 24rpx; left: 24rpx; z-index: 50;
  background: rgba(0,0,0,.35); color: #fff;
  padding: 10rpx 24rpx; border-radius: 30rpx; font-size: 28rpx;
}

/* 2. 轮播 */
.swiper { width: 100%; height: 520rpx; }
.swiper-img { width: 100%; height: 100%; background: #e9edf2; }
.swipe-count {
  position: fixed; top: 480rpx; right: 24rpx; z-index: 50;
  background: rgba(0,0,0,.45); color: #fff;
  padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx;
}

/* 卡片通用 */
.card { background: #fff; border-radius: 20rpx; margin: 20rpx 24rpx 0; padding: 24rpx; }
.block-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }

/* 3. 主信息 */
.main-row { display: flex; align-items: flex-start; justify-content: space-between; }
.brand { font-size: 38rpx; font-weight: 800; color: #1a1a1a; }
.model { font-size: 28rpx; font-weight: 500; color: #333; margin-top: 8rpx; }
.slogan { font-size: 34rpx; font-weight: 800; color: #c8102e; margin-top: 10rpx; }
.guide { font-size: 24rpx; color: #999; margin-top: 10rpx; }
.param-btn {
  display: flex; align-items: center; gap: 8rpx;
  background: #c8102e; color: #fff; font-size: 24rpx;
  padding: 14rpx 22rpx; border-radius: 30rpx; flex-shrink: 0;
}
.param-ico { font-size: 26rpx; }

/* 4. 口碑 */
.tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag {
  background: #f2f5fa; color: #4a6a9e; font-size: 24rpx;
  padding: 12rpx 22rpx; border-radius: 28rpx;
}

/* 5. 官方承诺 */
.promise {
  margin: 20rpx 24rpx 0; background: #fbf3df; border-radius: 20rpx;
  padding: 22rpx 24rpx; display: flex; align-items: center; gap: 20rpx;
}
.promise-title { font-weight: 800; color: #9a7b2e; font-size: 28rpx; flex-shrink: 0; }
.promise-items { display: flex; gap: 28rpx; color: #9a7b2e; font-size: 25rpx; }

/* 6. 特卖版本 */
.ver { border-top: 1rpx solid #f0f0f0; padding: 20rpx 0; }
.ver:first-of-type { border-top: none; }
.ver-top { display: flex; align-items: center; }
.ver-sale {
  background: #ffb300; color: #fff; font-size: 22rpx;
  padding: 4rpx 12rpx; border-radius: 8rpx; margin-right: 12rpx;
}
.ver-name { flex: 1; font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.ver-cfg { color: #1a6fe0; font-size: 24rpx; }
.ver-price { color: #c8102e; font-size: 34rpx; font-weight: 800; margin-top: 12rpx; }
.ver-guide { color: #999; font-size: 22rpx; margin-top: 4rpx; }
.ver-btns { display: flex; gap: 16rpx; margin-top: 16rpx; }
.vbtn {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: 32rpx;
  font-size: 26rpx; font-weight: 600;
}
.vbtn.ghost { background: #fff; color: #c8102e; border: 1rpx solid #c8102e; }
.vbtn.pink { background: #ff4d8d; color: #fff; }

/* 7. 底部导航 */
.footbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  height: 110rpx; background: #fff; border-top: 1rpx solid #eee;
  display: flex; align-items: center; padding: 0 16rpx calc(0rpx + env(safe-area-inset-bottom));
}
.foot-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  color: #666; font-size: 22rpx; gap: 4rpx;
}
.foot-item .fi { font-size: 30rpx; }
.foot-inquiry {
  flex: 1.6; background: #c8102e; color: #fff; text-align: center;
  padding: 22rpx 0; border-radius: 40rpx; font-weight: 700; font-size: 28rpx;
  margin-left: 12rpx;
}
